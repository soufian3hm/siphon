{
  "manifest_version": 3,
  "name": "Siphon",
  "version": "0.4.0",
  "description": "Hands downloads and media streams to the Siphon download manager.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "webRequest",
    "storage",
    "contextMenus",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Siphon",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
